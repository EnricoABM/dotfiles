# ==============================================================================
# CONFIGURAÇÃO DE CORES (Art Déco - Navy & Ivory)
# ==============================================================================
[colors]
bg_dark      = #000000 
bg_layer     = #000000
fg_bright    = #ffffff
fg_ivory     = #e0e1dd
accent_blue  = #415a77 
alert        = #e63946  

# ==============================================================================
# 1. BARRA SUPERIOR (Informações e Status)
# ==============================================================================
[bar/superior]
# Associa esta instância da barra à variável de ambiente MONITOR
monitor = ${env:MONITOR:}

width = 100%
height = 26pt
bottom = false

background = ${colors.bg_dark}
foreground = ${colors.fg_ivory}

line-size = 2pt
line-color = ${colors.fg_bright}

radius = 0
border-size = 0

padding-left = 2
padding-right = 2
module-margin = 1

font-0 = "JetBrainsMono Nerd Font:size=10;2"
font-1 = "JetBrainsMono Nerd Font:style=Bold:size=11;3"

# Janela ativa no centro, Relógio e Bateria na direita
modules-left = arch_logo xworkspaces
modules-center = xwindow
modules-right = cpu cpu-temp memory battery volume date powermenu

cursor-click = pointer
enable-ipc = true


# ==============================================================================
# MÓDULOS DA BARRA SUPERIOR
# ==============================================================================

[module/arch_logo]
type = custom/text
format = "󰣇 ‖"
format-foreground = ${colors.fg_bright}
format-font = 2

[module/xworkspaces]
type = internal/xworkspaces

# Garante que cada barra mostre apenas os workspaces do monitor em que ela está
pin-workspaces = true

label-active = "◆ %name%"
label-active-foreground = ${colors.fg_bright}
label-active-background = ${colors.bg_layer}
label-active-overline = ${colors.fg_bright}
label-active-padding = 1

label-occupied = "◇ %name%"
label-occupied-foreground = ${colors.fg_ivory}
label-occupied-padding = 1

label-empty = "― %name%"
label-empty-foreground = ${colors.accent_blue}
label-empty-padding = 1

# Mostra o título da janela em foco de forma elegante
[module/xwindow]
type = internal/xwindow
label = "%title:0:50:...%"
label-foreground = ${colors.fg_bright}
label-font = 2
# Se não houver janela aberta, fica em branco para manter a simetria
label-empty = "―" 
label-empty-foreground = ${colors.fg_bright}

[module/cpu]
type = internal/cpu
interval = 3
format-prefix = " "
format-prefix-foreground = ${colors.fg_bright}
label = %percentage%%

[module/cpu-temp]
type = custom/script
exec = sensors | awk '/Package id 0:/ {gsub(/[+°C]/, "", $4); print $4 "°C"; exit}'
interval = 3
label = %output%
format-prefix = " "
format-prefix-foreground = ${colors.fg_bright}
label-foreground = ${colors.fg_bright}

[module/memory]
type = internal/memory
interval = 3
format-prefix = "󰍛 "
format-prefix-foreground = ${colors.fg_bright}
label = %percentage_used%%

# Módulo de Bateria
[module/battery]
type = internal/battery
full-at = 99
low-at = 15
battery = BAT0
adapter = ADP1
poll-interval = 5

format-charging = <animation-charging> <label-charging>
format-discharging = <ramp-capacity> <label-discharging>

label-charging = %percentage%%
label-discharging = %percentage%%

label-full = "󰁹 100%"
label-full-foreground = ${colors.fg_bright}
label-low = "󰂃 %percentage%%"
label-low-foreground = ${colors.alert}

# Ícones geométricos de bateria carregando
animation-charging-0 = "󰢜"
animation-charging-1 = "󰂇"
animation-charging-2 = "󰂊"
animation-charging-3 = "󰂋"
animation-charging-foreground = ${colors.fg_bright}

# Ícones de descarga
ramp-capacity-0 = "󰁺"
ramp-capacity-1 = "󰁼"
ramp-capacity-2 = "󰁾"
ramp-capacity-3 = "󰂀"
ramp-capacity-4 = "󰁹"
ramp-capacity-foreground = ${colors.fg_bright}

# Alinhado à direita com espaçadores rígidos nas pontas
[module/date]
type = internal/date
interval = 1
date = "‖ %H:%M ‖"
date-alt = "‖ %Y-%m-%d  %H:%M:%S ‖"
label = %date%
label-font = 2
label-foreground = ${colors.fg_bright}

[module/powermenu]
type = custom/text
click-left = bspc quit
format = "󰐥"
format-foreground = ${colors.fg_bright}
format-font = 2

# ==============================================================================
# MÓDULO DE ÁUDIO / VOLUME (PipeWire / wpctl)
# ==============================================================================
[module/volume]
type = custom/script
exec = bash -c 'vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@); if echo "$vol" | grep -q "MUTED"; then echo "󰝟 Muted"; else percent=$(echo "$vol" | awk "{print int(\$2 * 100)}"); echo "󰕾 ${percent}%"; fi'
interval = 1
label-foreground = ${colors.fg_bright}

# Clique com botão esquerdo para mutar/desmutar
click-left = wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

format-foreground = ${colors.fg_bright}
format-font = 1
